# Copy to .env for local development (or set these in your hosting dashboard).
# Local default is SQLite; for PostgreSQL (e.g. Render), use:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/rosterflow
DATABASE_URL=sqlite:///./rosterflow.db

# Comma-separated frontend origins allowed to call the API.
# Local default (used when unset): http://localhost:5173,http://127.0.0.1:5173
# For deployment, set this to your Vercel URL, e.g. https://rosterflow.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
